# Copia este archivo como ".env" y completa los valores.
# Los encuentras en Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# (Opcional) WhatsApp de ventas que aparece en la página de inicio "/".
# Formato internacional sin "+" ni espacios: 5939XXXXXXXX
VITE_VENTAS_WHATSAPP=

# Si dejas VITE_SUPABASE_URL vacío, la app arranca en MODO DEMO:
# usa datos locales (guardados en el navegador) y no necesita backend.
